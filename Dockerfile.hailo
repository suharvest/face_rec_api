# Raspberry Pi 5 + Hailo-8 runtime image for the Standalone Face Recognition Service.
#
# Targets: Pi OS (bookworm/trixie) aarch64 hosts with the Hailo PCIe kernel
# driver (hailo_pci) + userland libhailort installed and *held* at 4.21.0:
#   sudo apt-mark hold hailort hailort-pcie-driver
#
# HailoRT ABI rule (see gotchas-rpi-hailo.md #1): kernel driver hailo_pci,
# userland libhailort.so and the Python binding _pyhailort must all match
# major.minor. Layout chosen here:
# - Python binding: the repo-bundled cp311 wheel
#   `hailort-4.21.0-cp311-cp311-linux_aarch64.whl` is installed INSIDE the
#   image against the image's Python 3.11. This decouples us from the host
#   Python (Pi OS trixie ships 3.13 — a host-mounted _pyhailort would be a
#   cp313 .so and fail to import in a 3.11 container).
# - libhailort.so.4.21.0 is baked INTO the image (self-contained — no host
#   userland library needed, the host only needs the hailort-pcie kernel
#   driver 4.21.0, apt-mark held). Source: the frigate-maintained HailoRT
#   redistribution, built for debian12 arm64 (exactly our base):
#     https://github.com/frigate-nvr/hailort/releases/download/v4.21.0/hailort-debian12-arm64.tar.gz
#   Fetched at build time via `ADD --checksum` with the sha256 pinned below,
#   so the build is reproducible and tamper-evident. The wheel's _pyhailort
#   links against the exact soname `libhailort.so.4.21.0`, so a library
#   version drift fails loudly at import time instead of corrupting
#   inference. (The 4.21.0 arm64 .deb is not distributable via apt — the RPi
#   archive only carries 4.20/4.23 — hence the tarball.)
#   The same release also publishes a cp311 wheel
#   (hailort-4.21.0-cp311-cp311-linux_aarch64.whl); we keep the repo-bundled
#   wheel (md5 2fde57f853ea66d670a60e68b4ca15da) which is the one validated
#   on-device. frigate's wheel (md5 626f6d6469f9bdadfc838483caf77ead) is a
#   different build and is noted here only as an alternative source.
#
# Image philosophy: slim runtime, ~1 GB unpacked.
# - Base: python:3.11-slim-bookworm.
# - Inference deps only — no torch, no onnxruntime, no dev tools. gcc is
#   installed transiently in the same layer purely to compile `netifaces`
#   (a hailort wheel dependency with no aarch64 wheel on PyPI) and purged
#   before the layer is committed.
# - HEF models and embeddings data are bind-mounted, not baked in.
# - Runs as non-root user `frc` (uid 1000 — matches the default `harvest`
#   user on the Pi so the mounted /data stays writable). /dev/hailo0 is
#   world-rw on Pi OS, so no extra group is needed.
#
# Run example (see docs/deployment.md for the full annotated command):
#   docker run -d --name frc-hailo \
#     --restart unless-stopped \
#     --device /dev/hailo0 \
#     -p 8001:8001 \
#     -v $HOME/face_rec_api/src:/app/src:ro \
#     -v $HOME/face_rec_api/models/hailo:/models:ro \
#     -v $HOME/face_rec_api/data:/data \
#     -v $HOME/face_rec_api/photos:/photos \
#     -e LIVENESS_ENABLED=true \
#     --log-opt max-size=10m --log-opt max-file=3 \
#     face_rec_api:hailo

FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Minimal system deps: libglib for opencv-python-headless (libgthread only —
# the headless wheel does NOT link libGL, so no libgl1/mesa: saves ~200 MB),
# libstdc++/libgcc for _pyhailort. DEB_MIRROR build-arg lets you swap to a
# regional mirror when deb.debian.org is unreachable from the build host.
ARG DEB_MIRROR=http://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEB_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null \
    || sed -i "s|http://deb.debian.org|${DEB_MIRROR}|g" /etc/apt/sources.list 2>/dev/null \
    || true \
 && apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 \
        libstdc++6 \
        libgcc-s1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# HailoRT userland library, baked in (self-contained image).
# Source: frigate-maintained HailoRT 4.21.0 redistribution for debian12/arm64.
# sha256 pinned — a changed upstream artifact fails the build instead of
# silently producing a different image.
ADD --checksum=sha256:dd840548eb5d0d147c99aee2cb013d39d64be09c5bc63061171fcfacf4547b3f \
    https://github.com/frigate-nvr/hailort/releases/download/v4.21.0/hailort-debian12-arm64.tar.gz \
    /tmp/hailort-debian12-arm64.tar.gz
RUN tar -xzf /tmp/hailort-debian12-arm64.tar.gz -C /tmp \
        rootfs/usr/local/lib/libhailort.so.4.21.0 \
 && install -m 0644 /tmp/rootfs/usr/local/lib/libhailort.so.4.21.0 /usr/lib/libhailort.so.4.21.0 \
 && ln -sf libhailort.so.4.21.0 /usr/lib/libhailort.so \
 && ldconfig \
 && rm -rf /tmp/hailort-debian12-arm64.tar.gz /tmp/rootfs

# Runtime Python deps + the HailoRT cp311 binding wheel.
# gcc/libc6-dev are needed only to build `netifaces` (hailort dep, sdist-only
# on aarch64) and are purged in the same layer to keep the image slim.
ARG PIP_INDEX=https://pypi.org/simple
COPY hailort-4.21.0-cp311-cp311-linux_aarch64.whl /tmp/
RUN pip3 config set global.index-url "${PIP_INDEX}" \
 && apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
 && pip3 install --no-cache-dir --upgrade pip \
 && pip3 install --no-cache-dir \
        "fastapi==0.104.1" \
        "uvicorn[standard]==0.24.0.post1" \
        "pydantic==2.5.0" \
        "numpy==1.26.2" \
        "opencv-python-headless==4.8.1.78" \
        "scikit-image==0.22.0" \
        "Pillow" \
        "python-multipart" \
        /tmp/hailort-4.21.0-cp311-cp311-linux_aarch64.whl \
 && rm /tmp/hailort-4.21.0-cp311-cp311-linux_aarch64.whl \
 && apt-get purge -y gcc libc6-dev \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

# Baked-in copy of the source; typically shadowed by a `-v src:/app/src:ro`
# bind-mount at run time (same pattern as the Jetson deployment) so code can
# be updated with a `git pull` + container restart, no rebuild.
COPY src ./src

RUN useradd --uid 1000 --create-home frc \
 && mkdir -p /models /data /photos \
 && chown frc:frc /data /photos
USER frc

ENV FACE_BACKEND=hailo \
    MODELS_PATH=/models \
    PHOTOS_FOLDER=/photos \
    EMBEDDINGS_JSON=/data/embeddings.json \
    LIVENESS_ENABLED=true \
    PYTHONPATH=/app/src \
    HOST=0.0.0.0 \
    PORT=8001

EXPOSE 8001

CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8001", "--app-dir", "/app/src"]
